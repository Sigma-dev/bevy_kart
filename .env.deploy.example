# Copy to `.env.deploy` (gitignored) for `scripts/deploy-itch.sh` / `just deploy`.
#
# The relay's shared password: `TURN_PASSWORD` in the server's systemd unit, and the secret the
# release workflow bakes into shipped builds.
TURN_PASSWORD=

# Optional overrides. The defaults are what shipped builds use.
# SIGNALLING_SERVER_URL=wss://signal.sigma-dev.eu/ws
# TURN_URL=turn:signal.sigma-dev.eu:3478
# TURN_USER=bevy_kart
# ITCH_PAGE=sigmatronic/bevy-kart
